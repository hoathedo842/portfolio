<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Contact Messages - Admin Panel</title>
    <!-- Reset CSS -->
    <link rel="stylesheet" href="/css/reset.css" />
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="/font/bootstrap-icons.min.css" />
    <!-- AOS Animation CSS -->
    <link rel="stylesheet" href="/css/aos.css" />
    <!-- Custom Dashboard CSS -->
    <link rel="stylesheet" href="/css/admin-dashboard.css" />
    <!-- Custom Contact CSS -->
    <link rel="stylesheet" href="/css/admin-contact.css" />
  </head>

  <body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top navbar-custom">
      <div class="container-fluid">
        <a class="navbar-brand" href="#">Admin Panel</a>

        <!-- Toggle Button for mobile sidebar -->
        <button
          class="btn btn-outline-light d-lg-none"
          type="button"
          id="sidebarToggle"
        >
          ☰
        </button>

        <!-- Welcome + Account Menu -->
        <div class="ms-auto d-flex align-items-center gap-3 position-relative">
          <div class="text-white fw-semibold d-none d-sm-block">
            Welcome, <%= currentUser.username %>
          </div>

          <!-- Account Button -->
          <button
            id="accountToggle"
            class="btn btn-outline-light btn-sm account-toggle"
            style="min-width: 90px"
          >
            Account
          </button>

          <!-- Custom Menu -->
          <div
            class="account-menu position-absolute"
            id="accountMenu"
            style="display: none"
          >
            <a class="dropdown-item" href="/api/v1/admin/portfolio">Portfolio Data</a>
            <a class="dropdown-item" href="/api/v1/admin/users/profile">Update Info</a>
            <form action="/api/v1/auth/signout" method="POST" class="mb-0">
              <button type="submit" class="dropdown-item">Sign Out</button>
            </form>
          </div>
        </div>
      </div>
    </nav>

    <!-- Sidebar -->
    <nav
      id="sidebarMenu"
      class="sidebar-custom sidebar-fixed sidebar-slide d-lg-block"
    >
      <ul class="nav flex-column px-3 pt-4">
        <li class="nav-item">
          <a class="nav-link" href="/api/v1/admin/dashboard">Dashboard</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/api/v1/admin/users">User Management</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/api/v1/admin/projects">Projects</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/api/v1/admin/dictionary">Dictionary</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/api/v1/admin/portfolio">Portfolio Data</a>
        </li>
        <li class="nav-item">
          <a class="nav-link active" href="/api/v1/admin/contact">Contact Messages</a>
        </li>
      </ul>
    </nav>

    <!-- Main Content -->
    <main class="main-content-fixed">
      <div class="container-fluid pt-5">
        
        <!-- Success Alert Banner -->
        <div id="successAlert" class="alert alert-success alert-dismissible fade show shadow-sm" role="alert" style="display: none;">
          <i class="bi bi-check-circle-fill me-2"></i> Action completed successfully!
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>

        <!-- Header Title -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pt-4 gap-3">
          <h2 class="mb-0">Client Inquiries & Messages (<%= totalMessages %>)</h2>
        </div>

        <!-- Message Table Card -->
        <div class="card mb-4 border-0 shadow-sm">
          <div class="card-header fw-bold">Messages Inbox</div>
          <div class="card-body">
            <% if (!messages || messages.length === 0) { %>
              <p class="text-muted text-center py-3">No contact messages received yet.</p>
            <% } else { %>
              <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle">
                  <thead>
                    <tr>
                      <th style="width: 50px;">#</th>
                      <th>Name</th>
                      <th>Email</th>
                      <th>Phone</th>
                      <th>Message</th>
                      <th>Status</th>
                      <th>Received At</th>
                      <th style="width: 90px;" class="text-center">Action</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% messages.forEach((msg, index) => { %>
                      <tr>
                        <td><%= index + 1 + (currentPage - 1) * 10 %></td>
                        <td class="fw-bold text-dark"><%= msg.name %></td>
                        <td>
                          <a href="mailto:<%= msg.email %>" class="text-decoration-none"><%= msg.email %></a>
                        </td>
                        <td><%= msg.phone ? msg.phone : 'N/A' %></td>
                        <td>
                          <span class="d-inline-block text-truncate" style="max-width: 200px;" title="<%= msg.message %>">
                            <%= msg.message %>
                          </span>
                        </td>
                        <td>
                          <% if (msg.status === 'read' || msg.isRead === true) { %>
                            <span class="badge bg-success">Read</span>
                          <% } else { %>
                            <span class="badge bg-warning text-dark">Unread</span>
                          <% } %>
                        </td>
                        <td class="small"><%= new Date(msg.createdAt).toLocaleString('vi-VN') %></td>
                        <td class="text-center">
                          <button
                            type="button"
                            class="btn btn-sm btn-outline-danger delete-btn"
                            data-id="<%= msg._id %>"
                            title="Delete Message"
                          >
                            <i class="bi bi-trash"></i>
                          </button>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>

              <!-- Pagination -->
              <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
                <nav aria-label="Message pagination" class="mt-4">
                  <ul class="pagination justify-content-center mb-0">
                    <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                      <a class="page-link" href="?page=<%= currentPage - 1 %>">&laquo;</a>
                    </li>
                    <% for (let i = 1; i <= totalPages; i++) { %>
                      <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                        <a class="page-link" href="?page=<%= i %>"><%= i %></a>
                      </li>
                    <% } %>
                    <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                      <a class="page-link" href="?page=<%= currentPage + 1 %>">&raquo;</a>
                    </li>
                  </ul>
                </nav>
              <% } %>
            <% } %>
          </div>
        </div>
      </div>
    </main>

    <!-- MODAL: CONFIRM DELETION -->
    <div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
          <div class="modal-header bg-danger text-white">
            <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i> Confirm Deletion</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body p-4 text-center">
            <p class="fs-5 mb-1">Are you sure you want to delete this message?</p>
            <p class="text-muted small">This action cannot be undone.</p>
          </div>
          <div class="modal-footer bg-light justify-content-center">
            <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Cancel</button>
            <form id="deleteForm" method="POST" class="d-inline">
              <button type="submit" class="btn btn-danger fw-semibold">Yes, Delete</button>
            </form>
          </div>
        </div>
      </div>
    </div>

    <!-- JS Scripts -->
    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/js/admin-dashboard.js"></script>
    <script src="/js/admin-contact.js"></script>
  </body>
</html>