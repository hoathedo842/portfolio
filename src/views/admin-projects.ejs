<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Manage Projects | Admin Dashboard</title>
    <link rel="stylesheet" href="/css/reset.css" />
    <link rel="stylesheet" href="/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="/css/admin-dashboard.css" />
    <link rel="stylesheet" href="/css/admin-projects.css" />
  </head>

  <body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top navbar-custom">
      <div class="container-fluid">
        <a class="navbar-brand" href="#">Admin Panel</a>
        <button class="btn btn-outline-light d-lg-none" type="button" id="sidebarToggle">☰</button>
        <div class="ms-auto d-flex align-items-center gap-3 position-relative">
          <div class="text-white fw-semibold d-none d-sm-block">
            Welcome, <%= currentUser.username %>
          </div>
          <button id="accountToggle" class="btn btn-outline-light btn-sm account-toggle" style="min-width: 90px">Account</button>
          <div class="account-menu position-absolute" id="accountMenu" style="display: none">
            <a class="dropdown-item" href="/api/v1/admin/users/profile">Update Info</a>
            <form action="/api/v1/auth/signout" method="POST" class="mb-0">
              <button type="submit" class="dropdown-item">Sign Out</button>
            </form>
          </div>
        </div>
      </div>
    </nav>

    <!-- Sidebar -->
    <nav id="sidebarMenu" class="sidebar-custom sidebar-fixed sidebar-slide d-lg-block">
      <ul class="nav flex-column px-3 pt-4">
        <li class="nav-item"><a class="nav-link" href="/api/v1/admin/dashboard">Dashboard</a></li>
        <li class="nav-item"><a class="nav-link" href="/api/v1/admin/users">User Management</a></li>
        <li class="nav-item"><a class="nav-link active" href="/api/v1/admin/projects">Projects</a></li>
        <li class="nav-item"><a class="nav-link" href="/api/v1/admin/dictionary">Dictionary</a></li>
        <li class="nav-item"><a class="nav-link" href="/api/v1/admin/portfolio">Portfolio Data</a></li>
        <li class="nav-item"><a class="nav-link" href="/api/v1/admin/contact">Contact Messages</a></li>
      </ul>
    </nav>

    <!-- Main Content -->
    <main class="main-content-fixed">
      <div class="container-fluid pt-5">
        
        <!-- Success Alert Banner -->
        <div id="successAlert" class="alert alert-success alert-dismissible fade show shadow-sm" role="alert" style="display: none;">
          <i class="bi bi-check-circle-fill me-2"></i> Action completed successfully!
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pt-4 gap-3">
          <h2>Project Management</h2>
          
          <!-- SEARCH FORM & ADD PROJECT BUTTON -->
          <div class="d-flex align-items-center gap-2 flex-wrap">
            <form action="/api/v1/admin/projects" method="GET" class="d-flex gap-2">
              <div class="input-group">
                <input type="text" class="form-control" name="search" placeholder="Search project title..." value="<%= typeof search !== 'undefined' ? search : '' %>">
                <button class="btn btn-outline-success bg-white" type="submit" title="Search">
                  <i class="bi bi-search"></i>
                </button>
                <% if (typeof search !== 'undefined' && search) { %>
                  <a href="/api/v1/admin/projects" class="btn btn-outline-secondary" title="Clear Search">
                    <i class="bi bi-x-lg"></i>
                  </a>
                <% } %>
              </div>
            </form>

            <button type="button" class="btn btn-success fw-semibold text-nowrap" data-bs-toggle="modal" data-bs-target="#addProjectModal">
              <i class="bi bi-plus-lg me-1"></i> Add New Project
            </button>
          </div>
        </div>

        <% 
          const totalProjects = projects ? projects.length : 0;
        %>

        <!-- STATS CARDS SECTION -->
        <div class="row g-3 mb-4 stats-cards">
          <div class="col-xl-4 col-md-6">
            <div class="card h-100">
              <div class="card-body">
                <h5 class="card-title">Total Projects</h5>
                <p class="card-text"><%= typeof totalProjects !== 'undefined' ? totalProjects : 0 %></p>
              </div>
            </div>
          </div>
        </div>
        <!-- END STATS CARDS -->

        <!-- Projects Table Card -->
        <div class="card mb-4 user-table">
          <div class="card-header d-flex justify-content-between align-items-center">
            <span>Projects List</span>
          </div>
          <div class="card-body">
            <% if (!projects || projects.length === 0) { %>
              <p class="text-muted text-center py-3">No projects found. Let's create your first project!</p>
            <% } else { %>
              <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle">
                  <thead>
                    <tr>
                      <th style="width: 50px;">#</th>
                      <th style="width: 90px;">Image</th>
                      <th>Title & Tech</th>
                      <th>Links (GitHub / Live)</th>
                      <th>Description</th>
                      <th style="width: 120px;" class="text-center">Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% projects.forEach((project, index) => { %>
                      <tr>
                        <td><%= index + 1 %></td>
                        <td>
                          <% if (project.imageUrl) { %>
                            <img src="<%= project.imageUrl %>" alt="<%= project.title %>" class="img-thumbnail" style="width: 70px; height: 45px; object-fit: cover;">
                          <% } else { %>
                            <span class="text-muted small">No image</span>
                          <% } %>
                        </td>
                        <td>
                          <div class="fw-bold text-dark"><%= project.title %></div>
                          <span class="badge bg-light text-dark border mt-1"><%= project.tech %></span>
                        </td>
                        <td>
                          <div class="small">
                            <% if (project.github) { %>
                              <a href="<%= project.github %>" target="_blank" class="text-decoration-none d-block text-truncate" style="max-width: 180px;">
                                <i class="bi bi-github me-1"></i> GitHub
                              </a>
                            <% } %>
                            <% if (project.live) { %>
                              <a href="<%= project.live %>" target="_blank" class="text-decoration-none d-block text-truncate text-success" style="max-width: 180px;">
                                <i class="bi bi-globe me-1"></i> Live Demo
                              </a>
                            <% } %>
                          </div>
                        </td>
                        <td>
                          <ul class="ps-3 mb-0 small text-muted project-desc-list">
                            <% if (project.description && project.description.length > 0) { %>
                              <% project.description.forEach(desc => { %>
                                <li><%= desc %></li>
                              <% }) %>
                            <% } %>
                          </ul>
                        </td>
                        <td class="text-center">
                          <a href="/api/v1/admin/projects/<%= project._id %>" class="btn btn-sm btn-outline-primary me-1" title="Edit">
                            <i class="bi bi-pencil-square"></i>
                          </a>
                          <button type="button" class="btn btn-sm btn-outline-danger delete-btn" data-id="<%= project._id %>" title="Delete">
                            <i class="bi bi-trash"></i>
                          </button>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>

              <!-- PAGINATION SECTION -->
              <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
                <nav aria-label="Project navigation" class="mt-4">
                  <ul class="pagination justify-content-center mb-0">
                    <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                      <a class="page-link" href="/api/v1/admin/projects?page=<%= currentPage - 1 %><%= search ? '&search=' + search : '' %>" tabindex="-1">Previous</a>
                    </li>
                    <% for(let i = 1; i <= totalPages; i++) { %>
                      <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                        <a class="page-link" href="/api/v1/admin/projects?page=<%= i %><%= search ? '&search=' + search : '' %>"><%= i %></a>
                      </li>
                    <% } %>
                    <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                      <a class="page-link" href="/api/v1/admin/projects?page=<%= currentPage + 1 %><%= search ? '&search=' + search : '' %>">Next</a>
                    </li>
                  </ul>
                </nav>
              <% } %>
              <!-- END PAGINATION -->

            <% } %>
          </div>
        </div>
      </div>
    </main>

    <!-- MODAL: ADD NEW PROJECT -->
    <div class="modal fade" id="addProjectModal" tabindex="-1" aria-labelledby="addProjectModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
          
          <div class="modal-header bg-light">
            <h5 class="modal-title fw-bold" id="addProjectModalLabel">Add New Project</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>

          <form action="/api/v1/admin/projects" method="POST" enctype="multipart/form-data">
            <div class="modal-body p-4">
              
              <div class="mb-3">
                <label for="title" class="form-label fw-semibold">Project Title <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="title" name="title" placeholder="e.g. E-Commerce Web App" required>
              </div>

              <div class="mb-3">
                <label for="tech" class="form-label fw-semibold">Tech Stack <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="tech" name="tech" placeholder="e.g. Node.js, Express, MongoDB" required>
              </div>

              <div class="row">
                <div class="col-md-6 mb-3">
                  <label for="github" class="form-label fw-semibold">GitHub URL <span class="text-danger">*</span></label>
                  <input type="url" class="form-control" id="github" name="github" placeholder="https://github.com/username/repo" required>
                </div>
                <div class="col-md-6 mb-3">
                  <label for="live" class="form-label fw-semibold">Live Demo URL</label>
                  <input type="url" class="form-control" id="live" name="live" placeholder="https://myproject.com">
                </div>
              </div>

              <div class="mb-3">
                <label for="imageInput" class="form-label fw-semibold">Project Image</label>
                <input type="file" class="form-control" id="imageInput" name="image" accept="image/*">
                <div class="form-text">Choose an image file from your computer (PNG, JPG, JPEG).</div>
                
                <div class="mt-2 text-center" id="imagePreviewContainer" style="display: none;">
                  <img id="imagePreview" src="" alt="Preview" class="img-thumbnail rounded shadow-sm" style="max-height: 150px; object-fit: cover;">
                </div>
              </div>

              <div class="mb-3">
                <label for="description" class="form-label fw-semibold">Description <span class="text-danger">*</span></label>
                <textarea class="form-control" id="description" name="description" rows="4" placeholder="- Developed RESTful APIs&#10;- Implemented user authentication" required></textarea>
                <div class="form-text">Each line corresponds to a bullet point item displayed on the home page.</div>
              </div>

            </div>
            
            <div class="modal-footer bg-light">
              <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" class="btn btn-success fw-semibold px-4">Save Project</button>
            </div>
          </form>

        </div>
      </div>
    </div>

    <!-- MODAL: CONFIRM DELETION -->
    <div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
          <div class="modal-header bg-danger text-white">
            <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i> Confirm Deletion</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body p-4 text-center">
            <p class="fs-5 mb-1">Are you sure you want to delete this project?</p>
            <p class="text-muted small">This action cannot be undone.</p>
          </div>
          <div class="modal-footer bg-light justify-content-center">
            <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Cancel</button>
            <form id="deleteForm" method="POST" class="d-inline">
              <button type="submit" class="btn btn-danger fw-semibold">Yes, Delete</button>
            </form>
          </div>
        </div>
      </div>
    </div>
    
    <!-- JS -->
    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/js/admin-dashboard.js"></script>
    <script src="/js/admin-projects.js"></script>
  </body>
</html>