<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Edit Portfolio - Admin Dashboard</title>

    <!-- Reset CSS -->
    <link rel="stylesheet" href="/css/reset.css" />
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="/font/bootstrap-icons.min.css" />
    <!-- AOS Animation CSS -->
    <link rel="stylesheet" href="/css/aos.css" />
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/admin-dashboard.css" />
  </head>

  <body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top navbar-custom">
      <div class="container-fluid">
        <a class="navbar-brand" href="#">Admin Panel</a>

        <!-- Toggle Button for mobile sidebar -->
        <button
          class="btn btn-outline-light d-lg-none"
          type="button"
          id="sidebarToggle"
        >
          ☰
        </button>

        <!-- Welcome + Account Menu -->
        <div class="ms-auto d-flex align-items-center gap-3 position-relative">
          <div class="text-white fw-semibold d-none d-sm-block">
            Welcome, <%= currentUser.username %>
          </div>

          <!-- Account Button -->
          <button
            id="accountToggle"
            class="btn btn-outline-light btn-sm account-toggle"
            style="min-width: 90px"
          >
            Account
          </button>

          <!-- Custom Menu -->
          <div
            class="account-menu position-absolute"
            id="accountMenu"
            style="display: none"
          >
            <a class="dropdown-item" href="/api/v1/admin/portfolio">
              <i class="bi bi-file-earmark-person me-2"></i> Portfolio Data
            </a>
            <a class="dropdown-item" href="/api/v1/admin/users/profile">
              Update Info
            </a>
            <form action="/api/v1/auth/signout" method="POST" class="mb-0">
              <button type="submit" class="dropdown-item">Sign Out</button>
            </form>
          </div>
        </div>
      </div>
    </nav>

    <!-- Sidebar -->
    <nav
      id="sidebarMenu"
      class="sidebar-custom sidebar-fixed sidebar-slide d-lg-block"
    >
      <ul class="nav flex-column px-3 pt-4">
        <li class="nav-item">
          <a class="nav-link" href="/api/v1/admin/dashboard">Dashboard</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/api/v1/admin/users">User Management</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/api/v1/admin/projects">Projects</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/api/v1/admin/dictionary">Dictionary</a>
        </li>
        <li class="nav-item">
          <a class="nav-link active fw-bold text-white" href="/api/v1/admin/portfolio">Portfolio Data</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/api/v1/admin/statistics">Statistics</a>
        </li>
      </ul>
    </nav>

    <!-- Main Content -->
    <main class="main-content-fixed">
      <div class="container-fluid pt-5">
        
        <div class="d-flex justify-content-between align-items-center mb-4 pt-4">
          <h2 class="fw-bold">Edit Portfolio</h2>
          <a href="/api/v1/admin/portfolio" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Back to Portfolio
          </a>
        </div>

        <div class="row justify-content-center pb-5">
          <div class="col-lg-10">
            <div class="card shadow-sm border-0 p-4">
              
              <form action="/api/v1/admin/portfolio/update" method="POST">
                
                <!-- About Section -->
                <h4 class="text-primary mb-3">👤 About Section</h4>
                <div class="mb-3">
                  <label class="form-label fw-semibold">Title</label>
                  <input type="text" name="title" class="form-control" value="<%= portfolio?.about?.title || '' %>" required />
                </div>

                <div class="mb-3">
                  <label class="form-label fw-semibold">Description</label>
                  <textarea name="description" class="form-control" rows="3" required><%= portfolio?.about?.description || '' %></textarea>
                </div>

                <div class="mb-3">
                  <label class="form-label fw-semibold">Education</label>
                  <input type="text" name="education" class="form-control" value="<%= portfolio?.about?.education || '' %>" required />
                </div>

                <hr class="my-4" />

                <!-- Contact Section -->
                <h4 class="text-primary mb-3">📞 Contact Section</h4>
                <div class="mb-3">
                  <label class="form-label fw-semibold">Email</label>
                  <input type="email" name="email" class="form-control" value="<%= portfolio?.contact?.email || '' %>" required />
                </div>

                <div class="mb-3">
                  <label class="form-label fw-semibold">Phone</label>
                  <input type="text" name="phone" class="form-control" value="<%= portfolio?.contact?.phone || '' %>" />
                </div>

                <hr class="my-4" />

                <!-- Skills Section -->
                <h4 class="text-primary mb-3">🛠️ Skills (JSON / Comma Separated Format)</h4>
                <p class="text-muted small">You can edit your skills items separated by commas below:</p>
                
                <% if (portfolio?.skills) { %>
                  <% portfolio.skills.forEach((skillGroup, index) => { %>
                    <div class="card bg-light border-0 p-3 mb-3">
                      <div class="mb-2">
                        <label class="form-label fw-semibold">Category Name</label>
                        <input type="text" name="skillCategories[<%= index %>]" class="form-control" value="<%= skillGroup.category %>" required />
                      </div>
                      <div>
                        <label class="form-label fw-semibold">Items (comma-separated)</label>
                        <input type="text" name="skillItems[<%= index %>]" class="form-control" value="<%= skillGroup.items.join(', ') %>" required />
                      </div>
                    </div>
                  <% }) %>
                <% } %>

                <hr class="my-4" />

                <!-- Interests Section -->
                <h4 class="text-primary mb-3">🎯 Interests</h4>
                <div class="mb-4">
                  <label class="form-label fw-semibold">Interests (comma-separated)</label>
                  <input type="text" name="interests" class="form-control" value="<%= portfolio?.interests ? portfolio.interests.join(', ') : '' %>" placeholder="Soccer, Video Games, Music" />
                </div>

                <!-- Submit Buttons -->
                <div class="d-flex gap-2">
                  <button type="submit" class="btn btn-success flex-grow-1 py-2 fw-semibold">
                    Save All Changes
                  </button>
                  <a href="/api/v1/admin/portfolio" class="btn btn-secondary py-2">
                    Cancel
                  </a>
                </div>

              </form>

            </div>
          </div>
        </div>

      </div>
    </main>

    <!-- JS -->
    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/js/admin-dashboard.js"></script>
  </body>
</html>