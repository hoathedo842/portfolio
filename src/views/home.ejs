<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= portfolioData?.about?.name ? `${portfolioData.about.name} | Web Developer` : "Portfolio" %></title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="/css/reset.css" />
  <link rel="stylesheet" href="/font/bootstrap-icons.min.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.19/css/intlTelInput.css"/>
  <link rel="stylesheet" href="/css/home.css">
</head>

<body>
  <nav class="site-navbar">
    <div class="nav-content">
      <a class="site-brand" href="#"><%= portfolioData?.about?.name || "DevPortfolio" %></a>
    
      <button class="menu-toggle" id="menuToggle" aria-label="Toggle navigation">
        <i class="bi bi-list"></i>
      </button>

      <ul class="nav-menu" id="navMenu">
        <li><a class="custom-nav-link" href="#about">About</a></li>
        <li><a class="custom-nav-link" href="#skills">Skills</a></li>
        <li><a class="custom-nav-link" href="#projects">Projects</a></li>
        <li><a class="custom-nav-link" href="#contact">Contact</a></li>
        <li><a class="signin-btn" href="/api/v1/auth/signin">Sign In</a></li>
      </ul>
    </div>
  </nav>

  <section id="about" class="hero-section">
    <div class="wrapper-container hero-animate">
      <div class="hero-inner">
        <p class="hero-greeting">Hello, I'm <%= portfolioData?.about?.name || "a Developer" %></p>
        <h1 class="hero-title"><%= portfolioData?.about?.title || "Building Digital Experiences" %></h1>
        <p class="hero-subtitle"><%= portfolioData?.about?.description || "I focus on clean code, modern web development, and effective database management." %></p>
        
        <div class="hero-links">
          <% if (portfolioData?.contact?.email) { %>
            <a href="mailto:<%= portfolioData.contact.email %>">
              <i class="bi bi-envelope-fill email-icon"></i> Email
            </a>
          <% } %>
          <% if (portfolioData?.contact?.socialLinks) { %>
            <% portfolioData.contact.socialLinks.forEach(link => { %>
              <a href="<%= link.url %>" target="_blank">
                <% if (link.name.toLowerCase().includes('github')) { %><i class="bi bi-github"></i><% } 
                   else if (link.name.toLowerCase().includes('linkedin')) { %><i class="bi bi-linkedin linkedin-icon"></i><% } 
                   else { %><i class="bi bi-link-45deg"></i><% } %>
                <%= link.name %>
              </a>
            <% }) %>
          <% } %>
        </div>
        
        <div class="hero-education">
          <i class="bi bi-mortarboard-fill"></i> <%= portfolioData?.about?.education || "Industrial University of Ho Chi Minh City" %>
        </div>
      </div>
    </div>
  </section>

  <section id="projects" class="section-pad bg-white-custom">
    <div class="wrapper-container">
      <div class="section-title-wrap reveal">
        <h2 class="section-title">Projects</h2>
      </div>
      <div class="projects-grid">
        <% if (locals.projectList) { projectList.forEach(project => { %>
          <div class="project-card reveal">
            <% if (project.imageUrl) { %><img src="<%= project.imageUrl %>" alt="<%= project.title %>"><% } %>
            <div class="project-body">
              <h5 class="project-title-text"><%= project.title %></h5>
              <p class="tech-stack"><%= project.tech %></p>
              <% if (project.description) { %>
                <ul class="project-desc-list">
                  <% project.description.forEach(desc => { %><li><%= desc %></li><% }) %>
                </ul>
              <% } %>
            </div>
          </div>
        <% }) } %>
      </div>
    </div>
  </section>

  <section id="skills" class="section-pad bg-secondary-custom">
    <div class="wrapper-container reveal">
      <div class="section-title-wrap">
        <h2 class="section-title">Skills</h2>
      </div>
      <div class="skills-grid">
        <% if (portfolioData?.skills) { portfolioData.skills.forEach(skill => { %>
            <div>
              <h4 class="skill-category"><%= skill.category %></h4>
              <div class="skill-badges-box">
                <% skill.items.forEach(item => { %>
                  <span class="skill-badge"><%= item %></span>
                <% }) %>
              </div>
            </div>
        <% }) } %>
      </div>
    </div>
  </section>

  <section id="contact" class="section-pad bg-white-custom">
    <div class="wrapper-container reveal">
      <div class="section-title-wrap">
        <h2 class="section-title">Get in touch</h2>
      </div>
      <div class="contact-flex-wrap">
        <div class="contact-card">
          <form id="contactForm">
            <div class="form-group-custom">
              <label class="form-label-custom">Name</label>
              <input type="text" name="name" class="form-control-custom" placeholder="John Doe" required>
            </div>
            <div class="form-group-custom">
              <label class="form-label-custom">Email</label>
              <input type="email" name="email" class="form-control-custom" placeholder="john@example.com" required>
            </div>
            <div class="form-group-custom">
              <label class="form-label-custom">Phone <span class="label-optional">(Optional)</span></label>
              <input type="tel" id="phone" name="phone" class="form-control-custom">
            </div>
            <div class="form-group-textarea">
              <label class="form-label-custom">Message</label>
              <textarea name="message" class="form-control-custom" rows="4" placeholder="How can I help you?" required></textarea>
            </div>
            <button type="submit" id="submitBtn" class="btn-submit">Send Message</button>
            
            <div id="formResponse" class="form-response-text"></div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <footer class="site-footer">
    <div class="wrapper-container">
      <p class="footer-text">
        &copy; <span id="currentYear"></span> <%= portfolioData?.about?.name || "Portfolio" %>. All rights reserved.
      </p>
    </div>
  </footer>

  <div class="custom-modal-backdrop" id="successModal">
    <div class="custom-modal-box">
      <div class="modal-icon-wrap">
        <i class="bi bi-check-lg" style="font-size: 2rem;"></i>
      </div>
      <h4 class="modal-title-text">Message Sent!</h4>
      <p class="modal-desc-text">Thank you for reaching out. I will get back to you as soon as possible.</p>
      <button type="button" class="modal-btn-close" id="closeModal">Got it</button>
    </div>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.19/js/intlTelInput.min.js"></script>
  <script src="/js/home.js"></script>
</body>
</html>