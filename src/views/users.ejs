<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>User Dictionary Manager</title>

    <!-- Reset CSS -->
    <link rel="stylesheet" href="/css/reset.css" />

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="/font/bootstrap-icons.min.css" />

    <!-- AOS Animation CSS -->
    <link rel="stylesheet" href="/css/aos.css" />

    <link rel="stylesheet" href="/css/users.css" />
  </head>

  <body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top navbar-custom">
      <div class="container-fluid">
        <a class="navbar-brand" href="#">User Panel</a>

        <!-- Toggle Button for mobile sidebar -->
        <button
          class="btn btn-outline-light d-lg-none"
          type="button"
          id="sidebarToggle"
        >
          ☰
        </button>

        <!-- Welcome + Account Menu -->
        <div class="ms-auto d-flex align-items-center gap-3 position-relative">
          <div class="text-white fw-semibold d-none d-sm-block">
            Welcome, <%= currentUser.username %>
          </div>

          <!-- Account Button -->
          <button
            id="accountToggle"
            class="btn btn-outline-light btn-sm account-toggle"
            style="min-width: 90px"
          >
            Account
          </button>

          <!-- Custom Menu -->
          <div
            class="account-menu position-absolute"
            id="accountMenu"
            style="display: none"
          >
            <a class="dropdown-item" href="/api/v1/user/profile">
              <i class="bi bi-person-gear me-2"></i> Update Info
            </a>
            <a class="dropdown-item" href="/api/v1/user/change-password">
              <i class="bi bi-key me-2"></i> Change Password
            </a>
            <form action="/api/v1/auth/signout" method="POST" class="mb-0">
              <button type="submit" class="dropdown-item text-danger">
                <i class="bi bi-box-arrow-right me-2"></i> Sign Out
              </button>
            </form>
          </div>
        </div>
      </div>
    </nav>

    <!-- Sidebar -->
    <nav
      id="sidebarMenu"
      class="sidebar-custom sidebar-fixed sidebar-slide d-lg-block"
    >
      <ul class="nav flex-column px-3 pt-4">
        <li class="nav-item">
          <a class="nav-link active" href="/api/v1/user/dashboard">
            <i class="bi bi-journal-bookmark me-2"></i> Dictionary
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/api/v1/user/profile">
            <i class="bi bi-person me-2"></i> Profile
          </a>
        </li>
      </ul>
    </nav>

    <!-- Main Content -->
    <main class="main-content-fixed">
      <div class="container-fluid pt-5">
        <h2 class="mb-4 pt-4">Dictionary Manager</h2>

        <!-- Add New Word & Import Excel Row -->
        <div class="row mb-4">
          <!-- Add New Word Card -->
          <div class="col-lg-8 mb-3 mb-lg-0">
            <div class="card h-100">
              <div class="card-header fw-bold">Add New Word</div>
              <div class="card-body">
                <form
                  action="/api/v1/user/dictionary"
                  method="POST"
                  class="row g-3"
                >
                  <div class="col-md-4">
                    <input
                      type="text"
                      name="word"
                      class="form-control"
                      placeholder="Word"
                      required
                    />
                  </div>
                  <div class="col-md-4">
                    <input
                      type="text"
                      name="pronunciation"
                      class="form-control"
                      placeholder="Pronunciation"
                    />
                  </div>
                  <div class="col-md-4">
                    <select name="partOfSpeech" class="form-select" required>
                      <option value="">Part of Speech</option>
                      <option>noun</option>
                      <option>verb</option>
                      <option>adjective</option>
                      <option>adverb</option>
                      <option>preposition</option>
                      <option>conjunction</option>
                      <option>interjection</option>
                      <option>pronoun</option>
                      <option>determiner</option>
                    </select>
                  </div>
                  <div class="col-md-6">
                    <input
                      type="text"
                      name="meaning"
                      class="form-control"
                      placeholder="Meaning"
                      required
                    />
                  </div>
                  <div class="col-md-6">
                    <input
                      type="text"
                      name="examples"
                      class="form-control"
                      placeholder="Examples (comma separated)"
                    />
                  </div>
                  <div class="col-12 text-end">
                    <button type="submit" class="btn btn-primary btn-sm">
                      <i class="bi bi-plus-lg me-1"></i> Add Word
                    </button>
                  </div>
                </form>
              </div>
            </div>
          </div>

          <!-- Import Excel Card -->
          <div class="col-lg-4">
            <div class="card h-100">
              <div class="card-header fw-bold">Import from Excel</div>
              <div class="card-body d-flex flex-column justify-content-center">
                <form
                  action="/api/v1/user/dictionary/import-excel"
                  method="POST"
                  enctype="multipart/form-data"
                  class="vstack gap-3"
                >
                  <input
                    type="file"
                    name="file"
                    class="form-control form-control-sm"
                    accept=".xlsx,.xls"
                    required
                  />
                  <button type="submit" class="btn btn-success btn-sm w-100">
                    <i class="bi bi-upload me-1"></i> Upload File
                  </button>
                </form>
              </div>
            </div>
          </div>
        </div>

        <!-- Vocabulary Table Card -->
        <div class="card mb-4">
          <div class="card-header d-flex justify-content-between align-items-center">
            <span>Vocabularies (<%= totalVocabularies %>)</span>
            <div class="d-flex gap-2">
              <a href="/api/v1/user/dashboard" class="btn btn-secondary btn-sm">
                <i class="bi bi-arrow-clockwise"></i> Reload
              </a>
              <a href="/api/v1/user/dictionary/export-excel" class="btn btn-success btn-sm">
                <i class="bi bi-file-earmark-excel"></i> Export
              </a>
            </div>
          </div>
          <div class="card-body">
            <!-- Search Form -->
            <form
              action="/api/v1/user/dashboard"
              method="get"
              class="d-flex mb-4"
            >
              <input
                type="text"
                name="search"
                value="<%= search || '' %>"
                class="form-control me-2"
                placeholder="Search vocabulary..."
              />
              <button type="submit" class="btn btn-primary">
                <i class="bi bi-search"></i>
              </button>
            </form>

            <% if (vocabularies.length === 0) { %>
            <p class="text-muted">No entries found.</p>
            <% } else { %>
            <div class="table-responsive">
              <table class="table table-bordered table-hover align-middle">
                <thead class="table-dark">
                  <tr>
                    <th>#</th>
                    <th>Word</th>
                    <th>Pronunciation</th>
                    <th>Part of Speech</th>
                    <th>Meaning</th>
                    <th>Examples</th>
                    <th>Updated</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% vocabularies.forEach((vocab, index) => { %>
                  <tr>
                    <td><%= index + 1 + (currentPage - 1) * 10 %></td>
                    <td class="fw-bold"><%= vocab.word %></td>
                    <td><%= vocab.pronunciation %></td>
                    <td><span class="badge bg-secondary"><%= vocab.partOfSpeech %></span></td>
                    <td><%= vocab.meaning %></td>
                    <td>
                      <% if (Array.isArray(vocab.examples)) { %>
                      <ul class="mb-0 ps-3">
                        <% vocab.examples.forEach(ex => { %>
                        <li><%= ex %></li>
                        <% }) %>
                      </ul>
                      <% } else { %> <%= vocab.examples %> <% } %>
                    </td>
                    <td><%= new Date(vocab.updatedAt).toLocaleDateString('vi-VN') %></td>
                    <td>
                      <div class="btn-group btn-group-sm" role="group">
                        <a
                          href="/api/v1/user/dictionary/<%= vocab._id %>"
                          class="btn btn-primary"
                          title="Edit"
                        >
                          <i class="bi bi-pencil"></i>
                        </a>
                        <form
                          action="/api/v1/user/dictionary/<%= vocab._id %>?_method=DELETE"
                          method="post"
                          onsubmit="return confirm('Are you sure?');"
                          class="mb-0"
                        >
                          <button
                            type="submit"
                            class="btn btn-danger rounded-0 rounded-end"
                            title="Delete"
                          >
                            <i class="bi bi-trash"></i>
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>

            <!-- Pagination -->
            <% if (totalPages > 1) { %>
            <nav aria-label="Vocabulary pagination" class="mt-4">
              <ul class="pagination justify-content-center">
                <% if (currentPage > 1) { %>
                <li class="page-item">
                  <a
                    class="page-link"
                    href="?page=<%= currentPage - 1 %>&search=<%= search %>"
                    >Previous</a
                  >
                </li>
                <% } else { %>
                <li class="page-item disabled">
                  <span class="page-link">Previous</span>
                </li>
                <% } %> <% for (let i = 1; i <= totalPages; i++) { %>
                <li
                  class="page-item <%= currentPage === i ? 'active' : '' %>"
                >
                  <a
                    class="page-link"
                    href="?page=<%= i %>&search=<%= search %>"
                    ><%= i %></a
                  >
                </li>
                <% } %> <% if (currentPage < totalPages) { %>
                <li class="page-item">
                  <a
                    class="page-link"
                    href="?page=<%= currentPage + 1 %>&search=<%= search %>"
                    >Next</a
                  >
                </li>
                <% } else { %>
                <li class="page-item disabled">
                  <span class="page-link">Next</span>
                </li>
                <% } %>
              </ul>
            </nav>
            <% } %> <% } %>
          </div>
        </div>
      </div>
    </main>

    <!-- JS -->
    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/js/users.js"></script>
  </body>
</html>